{
  "name": "@gigawatt/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Gigawatt Solana program: PDAs, Merkle, instruction builders, fetchers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./idl.json": "./src/idl.json"
  },
  "files": ["dist", "src/idl.json"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/web3.js": "^1.98.2"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.13",
    "bn.js": "^5.2.1",
    "js-sha3": "^0.9.3"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/web3.js": "^1.98.2",
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}

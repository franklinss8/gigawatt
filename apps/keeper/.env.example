# ---- cluster / program (SPEC §5) ----
NEXT_PUBLIC_CLUSTER=devnet                 # devnet | mainnet-beta
RPC_URL=https://api.devnet.solana.com      # falls back to NEXT_PUBLIC_RPC_URL
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_GWATT_MINT=
NEXT_PUBLIC_WATT_MINT=
NEXT_PUBLIC_USDC_MINT=                     # mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# ---- keeper identity ----
# JSON byte array, base58 secret, or a path to a keypair .json. On mainnet this
# wallet MUST be the pump.fun creator of GWATT (creator fees land on it).
KEEPER_KEYPAIR=[1,2,3,...]

# ---- web indexer ----
WEB_URL=http://localhost:3000
KEEPER_SECRET=change-me

# ---- snapshot ----
# comma list of owners or token accounts to exclude (bonding curve, PumpSwap pool, treasury, ...)
EXCLUDED_ADDRESSES=
HELIUS_API_KEY=                            # optional: use DAS getTokenAccounts instead of getProgramAccounts

# ---- fees (step 1) ----
MOCK_FEES=1                                # 1 on devnet: skip pump.fun, pretend MOCK_FEES_LAMPORTS were collected
MOCK_FEES_LAMPORTS=50000000                # 0.05 SOL

# ---- swap (step 2) ----
JUP_API=https://api.jup.ag/swap/v2         # v2 (/order + /execute). A base ending in /swap/v1 uses /quote + /swap.
JUPITER_API_KEY=                           # optional (keyless = 0.5 req/s)
JUP_SLIPPAGE_BPS=100
MOCK_SWAP=1                                # default: 1 unless NEXT_PUBLIC_CLUSTER=mainnet-beta
MOCK_USDC_AUTHORITY_KEYPAIR=               # devnet only: mint authority of the mock USDC mint
MOCK_SOL_PRICE_USD=150

# ---- run control ----
DRY_RUN=0                                  # 1: compute everything, send nothing, POST nothing
FORCE_FLUSH=0                              # 1: ignore the flush_interval check
